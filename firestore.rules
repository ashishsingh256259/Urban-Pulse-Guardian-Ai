rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Authentication & Identity Helpers
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Direct token email checks - evaluates instantaneously without recursive get() on users/{uid}
    function isAdminEmail() {
      return isAuthenticated() && request.auth.token.email != null && (
        request.auth.token.email == 'admin@urbanpulse.gov' ||
        request.auth.token.email == 'admin@urbanpulse.ai' ||
        request.auth.token.email == 'admin@urbanpulse.org' ||
        request.auth.token.email == 'rachel.chen@urbanpulse.gov' ||
        request.auth.token.email.matches('(?i).*admin.*')
      );
    }

    function isMunicipalEmail() {
      return isAuthenticated() && request.auth.token.email != null && (
        isAdminEmail() ||
        request.auth.token.email.matches('(?i).*@.*\\.gov\\.in$') ||
        request.auth.token.email.matches('(?i).*@urbanpulse\\.gov$') ||
        request.auth.token.email.matches('(?i).*municipal.*') ||
        request.auth.token.email.matches('(?i).*officer.*')
      );
    }

    function isFieldTeamEmail() {
      return isAuthenticated() && request.auth.token.email != null && (
        isMunicipalEmail() ||
        request.auth.token.email.matches('(?i).*field.*') ||
        request.auth.token.email.matches('(?i).*crew.*') ||
        request.auth.token.email.matches('(?i).*ops.*')
      );
    }

    // Authoritative Role Resolvers
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        isAdminEmail()
      );
    }

    function isMunicipal() {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.role == 'municipal' ||
        isMunicipalEmail()
      );
    }

    function isFieldTeam() {
      return isAuthenticated() && (
        isMunicipal() ||
        request.auth.token.role == 'field_team' ||
        request.auth.token.role == 'fieldTeam' ||
        isFieldTeamEmail()
      );
    }

    // Default deny all unhandled paths
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profiles:
    // Authenticated users can read and write their own profile document.
    // Admins can manage all user profiles.
    // Unauthenticated access is strictly denied.
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Field Teams Directory
    match /fieldTeams/{teamId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isMunicipal();
    }

    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isMunicipal();
    }

    // Citizen Incident Reports & Dispatch
    // Public safety records readable by any authenticated member.
    // Report creation strictly requires authenticated ownership.
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        (request.resource.data.isSOS == true && request.resource.data.userId == request.auth.uid) ||
        (request.auth.token.email != null && request.resource.data.reporterEmail == request.auth.token.email)
      );
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isMunicipal() ||
        isFieldTeam()
      );
      allow delete: if isMunicipal();
    }

    // AI Road Scans
    match /roadScans/{scanId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        isFieldTeam()
      );
      allow delete: if isMunicipal();
    }

    // Municipal Command Center Actions
    match /municipalActions/{actionId} {
      allow read: if isAuthenticated();
      allow create, update: if isMunicipal();
      allow delete: if isAdmin();
    }

    // Platform Audit Logs (Admin immutable ledger)
    match /auditLogs/{auditId} {
      allow read: if isMunicipal();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // User Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.recipientEmail == request.auth.token.email ||
        resource.data.recipientRole == 'all' ||
        (resource.data.recipientRole == 'admin' && isMunicipal()) ||
        (resource.data.recipientRole == 'municipal' && isMunicipal()) ||
        (resource.data.recipientRole == 'fieldTeam' && isFieldTeam()) ||
        (resource.data.recipientRole == 'citizen' && resource.data.recipientEmail == request.auth.token.email)
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isMunicipal();
    }

    // Incident Status History Audit Trail (Immutable)
    match /history/{historyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Citizen Rewards & Token Ledger
    match /rewards/{rewardId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isMunicipal()
      );
      allow create, update: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        isMunicipal()
      );
      allow delete: if isAdmin();
    }
  }
}
